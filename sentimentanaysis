        "import re\n",
        "def clean(text):\n",
        "  text=text.lower()\n",
        "  text=re.sub(r\"<.*?>\",\" \",text)\n",
        "  text=re.sub(r\"[^a-z\\s]\",\"\",text)\n",
        "  text=re.sub(r\"\\s+\",\" \",text).strip()\n",
        "  return text\n",
        "sample=\"This movie is great!!!!<br/><br/>Loved it,10/10.\"\n",
        "print(clean(sample))"
